# Railway environment variables
ARTIFACTS_PATH=model/arka_model_artifacts_v6.pkl
NLP_ARTIFACTS_PATH=model/arka_nlp_artifacts_v2.pkl
FUSION_ALPHA=0.8

# ─── Primary LLM provider: Groq (fast) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_URL=https://api.groq.com/openai/v1
# Hapus atau biarkan kosong kalau pakai Llama (reasoning_effort hanya untuk model yg support)
GROQ_REASONING_EFFORT=

# ─── Fallback LLM provider: Ollama Cloud (used if Groq fails) ─────────
OLLAMA_URL=https://ollama.com/v1
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=gpt-oss:120b-cloud
